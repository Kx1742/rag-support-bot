# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIMENSIONS=768
# RAG_MIN_SCORE=0.5

# gemini | offline. Unset = gemini when GEMINI_API_KEY is set, otherwise offline.
# LLM_PROVIDER=

# Web server
# PORT=3000
# DEFAULT_TENANT=bean-and-byte
# RATE_LIMIT_BURST=5
# RATE_LIMIT_PER_MINUTE=10
# DAILY_MESSAGE_LIMIT=500
# Set to 1 only when running behind a trusted reverse proxy (Render, Fly.io, nginx...)
# TRUST_PROXY=0

# Staff desk at /desk. At least 8 characters; the desk stays off when unset.
# STAFF_PASSWORD=
# Per business: STAFF_PASSWORD_BEAN_AND_BYTE=
# Set to 1 when served over HTTPS so the login cookie is Secure-only.
# COOKIE_SECURE=0
# The owner logs in at /desk with username "owner" and STAFF_PASSWORD, then adds staff accounts.

# Public demo: seeds sample data, shows demo logins, resets daily (or run: npm run start:demo)
# DEMO_MODE=1
# DEMO_RESET_HOUR=4
# Where databases, indexes and backups are stored (default ./data). Use a persistent disk in production.
# DATA_DIR=./data
# Automatic database backups (0 = off). Also: npm run backup
# BACKUP_EVERY_HOURS=24
