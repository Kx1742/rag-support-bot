{
  "name": "rag-support-bot",
  "version": "1.0.0",
  "description": "Multi-tenant customer-support chatbot that answers from a business's own documents (RAG + Gemini).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node src/server/main.ts",
    "dev": "node --watch src/server/main.ts",
    "ingest": "node src/cli/ingest.ts",
    "chat": "node src/cli/chat.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "backup": "node src/cli/backup.ts",
    "start:demo": "node src/server/main.ts --demo",
    "screenshots": "node scripts/screenshots.ts",
    "e2e": "node scripts/e2e.ts",
    "eval": "node scripts/eval.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
